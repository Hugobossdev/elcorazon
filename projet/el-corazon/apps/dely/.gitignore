# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables (ne jamais committer les vraies clés)
.env
.env.local
.env.*.local
!.env.example

# Secrets and API keys
**/secrets.dart
**/api_keys.dart
**/*_secret.dart
**/*_key.dart

# Secrets de compilation Android — jamais versionnés.
#
# `key.properties` porte les mots de passe du keystore de release.
# `maps.properties` porte la clé Google Maps Android, que `build.gradle.kts`
# injecte au manifeste. Elle y était en clair et suivie par git ; une clé Maps
# non restreinte se relève dans l'APK et se facture à son propriétaire.
**/key.properties
**/maps.properties
