# ===========================================
# El Corazon Fastfood - Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API
# Your Node.js backend URL (deployed on Render.com or local)
BACKEND_URL=https://backend-qbwe.onrender.com

# Backend Django v2 (Phase 6, authentification uniquement pour l'instant).
# 10.0.2.2 est l'alias de l'émulateur Android vers l'hôte ; utiliser
# localhost pour iOS/desktop/web.
API_BASE_URL=http://10.0.2.2:8000/api/v1

# PayDunya Payment Gateway
# Get credentials from: https://paydunya.com/developers
PAYDUNYA_MASTER_KEY=your-paydunya-master-key
PAYDUNYA_PRIVATE_KEY=your-paydunya-private-key
PAYDUNYA_TOKEN=your-paydunya-token
PAYDUNYA_IS_SANDBOX=true

# Google Maps API
# Get key from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Agora (Voice/Video Calls)
# Get credentials from: https://console.agora.io
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Firebase (Optional - for push notifications)
# FIREBASE_PROJECT_ID=your-firebase-project-id

# App Configuration
APP_NAME=El Corazon Fastfood
APP_ENV=development
