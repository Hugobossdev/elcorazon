# ===========================================
# El Corazon - Laravel Backend Environment
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the real .env file to git

# Application
APP_NAME="El Corazon API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Supabase Configuration
# The anon key is used for client-facing operations
# The service_role key is used for server-side operations (NEVER expose to client)
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database (PostgreSQL - Supabase)
DB_CONNECTION=pgsql
DB_HOST=your-supabase-project-ref.db.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# Cache & Queue
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# PayDunya Payment Gateway (PRODUCTION KEYS)
# Get credentials from: https://paydunya.com/developers
PAYDUNYA_MASTER_KEY=your-paydunya-master-key
PAYDUNYA_PRIVATE_KEY=your-paydunya-private-key
PAYDUNYA_TOKEN=your-paydunya-token
PAYDUNYA_IS_SANDBOX=false

# Agora RTC (Voice/Video Calls)
# The App Certificate is used to generate RTC tokens (SERVER-ONLY)
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Google Maps API (for server-side geocoding)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase (for push notifications)
# Get the service account JSON from: https://console.firebase.google.com/
FIREBASE_CREDENTIALS_JSON=your-firebase-service-account-json

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_TTL=1440

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
