# Modèle de configuration — copier en `.env` et renseigner.
#
# Aucune valeur réelle ne doit figurer dans ce fichier : il est versionné.
# `.env`, lui, est ignoré par git (voir .gitignore).

# ---------------------------------------------------------------- Django

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

LOG_LEVEL=INFO

# ---------------------------------------------------------------- base de données

POSTGRES_DB=elcorazon
POSTGRES_USER=elcorazon
POSTGRES_PASSWORD=
POSTGRES_HOST=db          # `localhost` hors Docker
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# GeoDjango exige GDAL et GEOS, qui sont des bibliothèques système présentes
# dans l'image Docker et en CI. Mettre à False permet à un poste sans Docker
# d'exécuter le sous-ensemble non géospatial de la suite — jamais de livrer.
GIS_ENABLED=True

# ---------------------------------------------------------------- Redis

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------------------------------------------------------------- JWT (ADR-004)

# Paire RSA pour RS256. Générer avec :
#   openssl genpkey -algorithm RSA -out jwt.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt.pem -pubout -out jwt.pub
# Puis coller le contenu, sauts de ligne remplacés par \n.
JWT_SIGNING_KEY=
JWT_VERIFYING_KEY=

# ---------------------------------------------------------------- stockage objet

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=elcorazon
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---------------------------------------------------------------- métier

# ISO-4217. XOF (franc CFA) n'a aucune décimale — voir ADR-007.
DEFAULT_CURRENCY=XOF

# ---------------------------------------------------------------- services externes

# Firebase Cloud Messaging — chemin du fichier de compte de service
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=

# PayDunya
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
# Secret de vérification de signature du webhook. Sans lui, n'importe qui peut
# déclarer une commande payée (P1, P2).
PAYDUNYA_WEBHOOK_SECRET=

# Google Maps Platform — itinéraires, géocodage, distances
GOOGLE_MAPS_API_KEY=

# Agora RTC — le backend n'émet qu'un jeton, le média ne transite pas par lui
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---------------------------------------------------------------- production

# Requis uniquement par config.settings.prod
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
